{
  "name": "fisheries-connect-cloudflare",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run preflight && npm run build && node scripts/cloudflare.mjs deploy",
    "admin:password": "node --experimental-strip-types scripts/admin-password.mjs",
    "configure": "node scripts/configure.mjs",
    "preflight": "node scripts/preflight.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/cloudflare.mjs migrate",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@cloudflare/workers-types": "4.20260515.1",
    "wrangler": "4.92.0",
    "esbuild": "0.28.2"
  }
}
